# Database Connection (Supabase)
# For direct connection: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# For transaction pooler: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/psyconnect"

# Authentication Secrets (NextAuth.js v5)
AUTH_SECRET="generate_with_openssl_rand_hex_32"
AUTH_URL="http://localhost:3000"

# ML Microservice
ML_API_URL="http://127.0.0.1:5000"
ML_SERVICE_URL="http://127.0.0.1:5000"
